#!/usr/bin/env python3
"""Install the seven-role research workflow into a project without overwriting local work."""
import argparse
import hashlib
import json
import subprocess
import sys
from datetime import datetime,timezone
from pathlib import Path

TOOLKIT=Path(__file__).resolve().parent.parent
SOURCE=TOOLKIT/'workflows/research'
DIRECTORIES=['questions','tasks','sources','hypotheses','experiments','observations','claims','reviews','decisions','sessions']
BLOCK='''<!-- research-workflow:start -->
## Research workflow

Read research/WORKFLOW.md and research/brief.md before research work.
Use all seven roles; the coordinator manages handoffs and a single Git writer.
The verifier reviews protocol, implementation, and conclusions independently.
Research records are authoritative; Graphify is the derived code index.
Preserve failures, raw evidence, counterevidence, and explicit uncertainty.
Use the principal investigator's agreed scope and budget; record consequential changes.
Validate records with .research-toolkit/checks/validate_records.py before acceptance.
<!-- research-workflow:end -->'''

def digest(data): return hashlib.sha256(data).hexdigest()
def git(*args):
    result=subprocess.run(['git','-C',str(TOOLKIT),*args],capture_output=True,text=True)
    return result.stdout.strip() if result.returncode==0 else None

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('project',nargs='?',default='.')
    parser.add_argument('--update',action='store_true',help='update only unchanged previously installed toolkit files; preserve customizations')
    parser.add_argument('--graphify',action='store_true',help='also run graphify-init (installs/builds Graphify and its integrations)')
    args=parser.parse_args()
    root=Path(args.project).expanduser().resolve(); root.mkdir(parents=True,exist_ok=True)
    # No installation writes may traverse a symlink within the target project.
    def target(relative):
        path=root/relative
        for part in [path,*path.parents]:
            if part==root: break
            if part.is_symlink(): raise ValueError(f'preserving symlink; cannot install through {part.relative_to(root)}')
        return path
    metadata=target('research/toolkit_version.json')
    previous=json.loads(metadata.read_text()) if metadata.exists() else {'files':{}}
    files=dict(previous.get('files',{})); changes=[]; preserved=[]
    revision=git('rev-parse','HEAD')
    dirty=bool(git('status','--porcelain','--','bin/research-init','workflows/research'))
    if metadata.exists() and not args.update:
        print('[research-init] existing installation: preserving files; use --update to refresh unchanged managed files')
    def install(relative,data,managed=True):
        path=target(relative); current=path.read_bytes() if path.exists() else None
        old=files.get(relative)
        if current is not None:
            if current==data: return
            if not (args.update and managed and old and digest(current)==old['sha256']):
                preserved.append(relative); return
        path.parent.mkdir(parents=True,exist_ok=True); path.write_bytes(data); changes.append(relative)
        if managed: files[relative]={'sha256':digest(data),'source_revision':revision,'source_dirty':dirty}
    for directory in DIRECTORIES:
        target(f'research/{directory}').mkdir(parents=True,exist_ok=True)
    for directory in ['src','configs','tests/verification','scripts','analysis','runs']:
        target(directory).mkdir(parents=True,exist_ok=True)
    for path in sorted((SOURCE/'agents').glob('*.md')):
        install(f'.claude/agents/{path.name}',path.read_bytes())
    for folder in ['schemas','checks','templates']:
        for path in sorted((SOURCE/folder).rglob('*')):
            if path.is_file() and '__pycache__' not in path.parts:
                install(f'.research-toolkit/{folder}/{path.relative_to(SOURCE/folder)}',path.read_bytes())
    install('.research-toolkit/requirements.txt',(SOURCE/'requirements.txt').read_bytes())
    install('research/WORKFLOW.md',(SOURCE/'README.md').read_bytes())
    for name,destination in [('brief.md','research/brief.md'),('state.yaml','research/state.yaml'),('question.md','research/questions/Q-001.md')]:
        install(destination,(SOURCE/'templates'/name).read_bytes(),False)
    session=b'# Session notes\n\nWorking notes here are unreviewed. Promote findings through canonical records and applicable review.\n'
    install('research/sessions/README.md',session,False)
    claude=target('CLAUDE.md'); original=claude.read_text() if claude.exists() else ''
    if '<!-- research-workflow:start -->' not in original:
        claude.write_text(original+('\n\n' if original else '')+BLOCK+'\n');changes.append('CLAUDE.md')
    ignore=target('.gitignore'); current_ignore=ignore.read_text() if ignore.exists() else ''
    missing=[rule for rule in ['.venv-research/','__pycache__/'] if rule not in current_ignore.splitlines()]
    if missing:
        ignore.write_text(current_ignore+('\n' if current_ignore and not current_ignore.endswith('\n') else '')+'\n# Local research tooling\n'+'\n'.join(missing)+'\n')
        changes.append('.gitignore')
    # Project scientific records and customizations are never replaced by --update.
    effective={name:{**entry,'local_sha256':digest(target(name).read_bytes()) if target(name).is_file() else None}
               for name,entry in files.items()}
    info={'format_version':1,'toolkit_revision':revision,'toolkit_dirty':dirty,
          'installed_at':datetime.now(timezone.utc).isoformat(),'files':effective}
    # A no-op rerun must not produce spurious Git changes or a misleading new revision.
    if changes or not metadata.exists():
        metadata.parent.mkdir(parents=True,exist_ok=True)
        metadata.write_text(json.dumps(info,indent=2)+'\n')
    print(f'[research-init] {root}: {len(changes)} files installed/updated; {len(preserved)} existing files preserved')
    for name in preserved: print(f'[research-init] preserved {name}')
    print('[research-init] next: fill research/brief.md and questions/Q-001.md; agree plan and budget with the PI')
    print('[research-init] start Claude Code here: claude --agent coordinator')
    print('[research-init] validate with python .research-toolkit/checks/validate_records.py .')
    if args.graphify:
        subprocess.run([str(TOOLKIT/'bin/graphify-init'),str(root)],check=True)
    return 0

if __name__=='__main__':
    try: raise SystemExit(main())
    except (OSError,ValueError,subprocess.CalledProcessError) as exc:
        print(f'[research-init] {exc}',file=sys.stderr);raise SystemExit(1)
