{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-setup.local/research/task.schema.json",
  "title": "task",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "origin",
    "scope",
    "references",
    "version",
    "objective",
    "owner",
    "inputs",
    "allowed_writes",
    "budget",
    "expected_outputs",
    "acceptance_criteria",
    "dependencies",
    "outputs",
    "uncertainties",
    "blockers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "kind": {
      "const": "task"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "blocked",
        "reviewed",
        "cancelled"
      ]
    },
    "origin": {
      "enum": [
        "human",
        "agent_generated",
        "measured",
        "imported"
      ]
    },
    "scope": {
      "type": "object",
      "minProperties": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "enum": [
        "coordinator",
        "literature",
        "hypothesis",
        "methodology",
        "engineer",
        "verifier",
        "analyst"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference",
          "version"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "allowed_writes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "limits"
      ],
      "properties": {
        "limits": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "author": {
      "type": "object",
      "required": [
        "role",
        "model",
        "session"
      ],
      "properties": {
        "role": {
          "enum": [
            "coordinator",
            "literature",
            "hypothesis",
            "methodology",
            "engineer",
            "verifier",
            "analyst",
            "human"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
