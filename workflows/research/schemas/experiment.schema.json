{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-setup.local/research/experiment.schema.json",
  "title": "experiment",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "origin",
    "scope",
    "references",
    "version",
    "hypothesis",
    "mode",
    "prediction",
    "baselines",
    "controlled_variables",
    "ablations",
    "metrics",
    "data_separation",
    "repetitions",
    "failure_criteria",
    "budget",
    "interpretation_limits",
    "measurement_protocol",
    "implementation",
    "configuration",
    "required_reviews",
    "changes",
    "runs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3,}$"
    },
    "kind": {
      "const": "experiment"
    },
    "status": {
      "enum": [
        "draft",
        "protocol_reviewed",
        "implementation_reviewed",
        "executing",
        "completed",
        "superseded"
      ]
    },
    "origin": {
      "enum": [
        "human",
        "agent_generated",
        "measured",
        "imported"
      ]
    },
    "scope": {
      "type": "object",
      "minProperties": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hypothesis": {
      "type": "string",
      "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
    },
    "mode": {
      "enum": [
        "exploratory",
        "confirmatory"
      ]
    },
    "prediction": {
      "type": "string",
      "minLength": 1
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controlled_variables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ablations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "units",
          "aggregation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "data_separation": {
      "type": "string",
      "minLength": 1
    },
    "repetitions": {
      "type": "string",
      "minLength": 1
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "string",
      "minLength": 1
    },
    "interpretation_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurement_protocol": {
      "type": "object",
      "minProperties": 1
    },
    "implementation": {
      "type": "object",
      "required": [
        "file",
        "symbol",
        "commit",
        "patch"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "required_reviews": {
      "type": "object",
      "required": [
        "protocol",
        "implementation"
      ],
      "properties": {
        "protocol": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q|TASK|SRC|HYP|EXP|RUN|OBS|CLM|REV|DEC)-[0-9]{3,}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
